VITE_AUTH0_DOMAIN=SEU_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=SEU_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://simuladopf-api
# Em desenvolvimento, /api usa o proxy Vite.
# Na Vercel, /api usa o rewrite descrito no README, ou configure a URL HTTPS da API.
VITE_API_URL=/api
VITE_AUTH0_ROLES_CLAIM=https://social-insper.com/roles
VITE_AUTH0_EMAIL_CLAIM=https://social-insper.com/email
